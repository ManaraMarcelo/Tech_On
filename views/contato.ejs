<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main role="main">
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="notificationToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="bi bi-check-circle-fill me-2 text-success" aria-hidden="true"></i>
                <strong class="me-auto">TechON</strong>
                <small>Agora mesmo</small>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Sua mensagem foi enviada com sucesso! Retornaremos em breve.
            </div>
        </div>
    </div>

    <section class="bg-light py-5 text-center">
        <div class="container">
            <h1 class="display-4 fw-bold">Entre em Contato</h1>
            <p class="lead text-muted">Estamos prontos para transformar seu espaço em uma experiência virtual única.</p>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-7">
                    <h2 class="fw-bold mb-3">Solicite seu Orçamento</h2>
                    <p class="text-muted mb-4">Preencha o formulário abaixo e nossa equipe retorna em até 24 horas.</p>

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger" role="alert">
                            <%= error %>
                        </div>
                    <% } %>

                    <form id="contactForm" action="/contato" method="POST">
                        
                        <input type="hidden" name="_next" value="https://tech-on-eight.vercel.app/contato?status=sucesso">
                        <input type="hidden" name="_captcha" value="false">
                        <input type="hidden" name="_subject" value="Novo Contato do Site TechON!">

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label">Nome Completo</label>
                                <input type="text" class="form-control" id="name" name="nome" required>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label">E-mail</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                            <div class="col-md-6">
                                <label for="phone" class="form-label">Telefone / WhatsApp</label>
                                <input type="tel" class="form-control" id="phone" name="telefone" required>
                            </div>
                            <div class="col-md-6">
                                <label for="cpf" class="form-label">CPF</label>
                                <input type="text" class="form-control" id="cpf" name="cpf" placeholder="000.000.000-00" required aria-describedby="cpfFeedback">
                                <div id="cpfFeedback" class="invalid-feedback" style="display: none;">
                                    Por favor, digite um CPF válido.
                                </div>
                            </div>
                            <div class="col-12">
                                <label for="service" class="form-label">Serviço de Interesse</label>
                                <select id="service" class="form-select" name="servico">
                                    <option selected>Selecione um serviço...</option>
                                    <option>Tour Virtual 360°</option>
                                    <option>Fotografia Imobiliária</option>
                                    <option>Matterport 3D</option>
                                    <option>Vídeos Promocionais</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label for="message" class="form-label">Mensagem</label>
                                <textarea class="form-control" id="message" name="mensagem" rows="4" placeholder="Conte-nos mais sobre o seu projeto..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg w-100">Enviar Solicitação</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="col-lg-5">
                    <h2 class="fw-bold mb-3">Nossos Canais</h2>
                    <p class="text-muted mb-4">Você também pode nos encontrar aqui:</p>
                    <div class="d-flex flex-column gap-4">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-telephone-fill fs-4 text-primary me-3" aria-hidden="true"></i>
                            <div>
                                <h5 class="fw-bold mb-0">Celular</h5>
                                <p class="text-muted mb-0">(19) 99736-9589</p>
                                <p class="text-muted mb-0">(19) 97816-0773</p>
                            </div>
                        </div>
                        <div class="d-flex align-items-start">
                            <i class="bi bi-geo-alt-fill fs-4 text-primary me-3" aria-hidden="true"></i>
                            <div>
                                <h5 class="fw-bold mb-0">Endereço</h5>
                                <p class="text-muted mb-0">Avenida 22 de Outubro, 1404<br>Mogi-Mirim - SP</p>
                            </div>
                        </div>
                        <a href="https://wa.me/5519997369589" class="btn btn-success btn-lg d-flex align-items-center justify-content-center mt-3" target="_blank">
                            <i class="bi bi-whatsapp me-2" aria-hidden="true"></i> Chamar no WhatsApp
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="map-section">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3680.212597705415!2d-46.954364!3d-22.434845!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94c8cb6ad8b9b2f9%3A0x123456789abcdef!2sAv.%2022%20de%20Outubro%2C%201404%20-%20Mogi%20Mirim%20-%20SP!5e0!3m2!1spt-BR!2sbr!4v1724458872019!5m2!1spt-BR!2sbr" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
    </section>
</main>

<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="loginModalLabel">Acessar sua Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loginError" class="alert alert-danger d-none" role="alert">
                    E-mail ou senha incorretos. Tente novamente.
                </div>
                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="emailInput" class="form-label">Endereço de e-mail</label>
                        <input type="email" class="form-control" id="emailInput" name="email" placeholder="seuemail@exemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="passwordInput" name="senha" placeholder="Sua senha" required>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="rememberCheck">
                            <label class="form-check-label" for="rememberCheck">Lembrar de mim</label>
                        </div>
                        <a href="#" class="form-text text-decoration-none">Esqueceu sua senha?</a>
                    </div>
                    <button type="submit" id="loginButton" class="btn btn-primary w-100 btn-lg">Entrar</button>
                </form>
                <hr>
                <div class="text-center">
                    <p class="text-muted">Não tem uma conta? <a href="/registrar" class="text-decoration-none fw-bold">Cadastre-se</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>