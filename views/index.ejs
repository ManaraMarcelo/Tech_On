<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main role="main">
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="accessDeniedToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Acesso Negado!</strong><br>
                    Você não tem permissão para acessar essa área.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        <div id="registerSuccessToast" class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Cadastro realizado!</strong><br>
                    Sua conta foi criada. Faça login para continuar.
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 start-50 translate-middle-x p-3" style="z-index: 1100">
        <div id="terminalToast" class="toast align-items-center text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="10000">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi bi-terminal-fill me-2 fs-5"></i>
                    <div>
                        <strong>Modo de Demonstração Acadêmica</strong><br>
                        O código de recuperação foi enviado para o <strong>TERMINAL (Console)</strong> do servidor.
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <section class="hero-section text-white py-5" style="background: linear-gradient(135deg, #4285f4, #3367d6);">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold">Transforme Espaços em <span class="text-highlight">Experiências Virtuais</span> Imersivas</h1>
                    <p class="lead mb-4 opacity-75">Criamos tours virtuais 360° de alta qualidade que permitem aos seus clientes explorarem cada detalhe do ambiente como se estivessem fisicamente presentes.</p>
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <a href="/contato" class="btn btn-light btn-lg px-4">Solicitar Orçamento</a>
                        <a href="/portfolio" class="btn btn-outline-light btn-lg px-4">Ver Portfólio</a>
                    </div>
                </div>
                <div class="col-lg-6 d-flex justify-content-center align-items-center">
                    <img src="/img/oculos.png" class="img-fluid rounded-3 shadow-lg" alt="Óculos de Realidade Virtual exibindo um tour imersivo de um ambiente interno">
                </div>
            </div>
        </div>
    </section>

    <section class="portfolio-preview py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold">Projetos em Destaque</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/vYCjNuY8BSb/thumb" class="card-img-top" alt="Fatec" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Fatec</h5>
                            <p class="card-text text-muted small">Tour virtual pelos ambientes da Fatec Mogi Mirim.</p>
                            <a href="https://my.matterport.com/show/?m=vYCjNuY8BSb" class="btn btn-primary btn-sm mt-2" target="_blank" rel="noopener">Ver Tour</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/31n8LB2vvxn/thumb" class="card-img-top" alt="Estúdio de Boxe" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Estúdio de Boxe</h5>
                            <p class="card-text text-muted small">Tour virtual do estúdio de boxe Mario Paiva.</p>
                            <a href="https://my.matterport.com/show/?m=31n8LB2vvxn" class="btn btn-primary btn-sm mt-2" target="_blank">Ver Tour</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/rCybmEbgj4Q/thumb" class="card-img-top" alt="Paiva Utilidades" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Paiva Utilidades</h5>
                            <p class="card-text text-muted small">Tour virtual completo da loja de utilidades Paiva.</p>
                            <a href="https://my.matterport.com/show/?m=rCybmEbgj4Q" class="btn btn-primary btn-sm mt-2" target="_blank" rel="noopener">Ver Tour</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/authModals') %>
    
<%- include('partials/footer') %>