<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main role="main">
    <section class="hero-section text-white py-5" style="background: linear-gradient(135deg, #4285f4, #3367d6);">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold">Transforme Espaços em <span class="text-highlight">Experiências Virtuais</span> Imersivas</h1>
                    <p class="lead mb-4 opacity-75">Criamos tours virtuais 360° de alta qualidade que permitem aos seus clientes explorarem cada detalhe do ambiente como se estivessem fisicamente presentes.</p>
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <a href="/contato" class="btn btn-light btn-lg px-4">Solicitar Orçamento</a>
                        <a href="/portfolio" class="btn btn-outline-light btn-lg px-4">Ver Portfólio</a>
                    </div>
                </div>
                <div class="col-lg-6 d-flex justify-content-center align-items-center">
                    <img src="/img/oculos.png" class="img-fluid rounded-3 shadow-lg" alt="Óculos de Realidade Virtual exibindo um tour imersivo de um ambiente interno">
                </div>
            </div>
        </div>
    </section>

    <section class="portfolio-preview py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold">Projetos em Destaque</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/vYCjNuY8BSb/thumb" class="card-img-top" alt="Fatec" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Fatec</h5>
                            <p class="card-text text-muted small">Tour virtual pelos ambientes da Fatec Mogi Mirim.</p>
                            <a href="https://my.matterport.com/show/?m=vYCjNuY8BSb" class="btn btn-primary btn-sm mt-2" target="_blank" rel="noopener">Ver Tour</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/31n8LB2vvxn/thumb" class="card-img-top" alt="Estúdio de Boxe" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Estúdio de Boxe</h5>
                            <p class="card-text text-muted small">Tour virtual do estúdio de boxe Mario Paiva.</p>
                            <a href="https://my.matterport.com/show/?m=31n8LB2vvxn" class="btn btn-primary btn-sm mt-2" target="_blank">Ver Tour</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 overflow-hidden">
                        <img src="https://my.matterport.com/api/v1/player/models/rCybmEbgj4Q/thumb" class="card-img-top" alt="Paiva Utilidades" style="height: 220px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">Paiva Utilidades</h5>
                            <p class="card-text text-muted small">Tour virtual completo da loja de utilidades Paiva.</p>
                            <a href="https://my.matterport.com/show/?m=rCybmEbgj4Q" class="btn btn-primary btn-sm mt-2" target="_blank" rel="noopener">Ver Tour</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="loginModalLabel">Acessar sua Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loginError" class="alert alert-danger d-none" role="alert">
                    E-mail ou senha incorretos. Tente novamente.
                </div>
                <form>
                    <div class="mb-3">
                        <label for="emailInput" class="form-label">Endereço de e-mail</label>
                        <input type="email" class="form-control" id="emailInput" placeholder="seuemail@exemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="passwordInput" placeholder="Sua senha" required>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="rememberCheck">
                            <label class="form-check-label" for="rememberCheck">Lembrar de mim</label>
                        </div>
                        <a href="#" class="form-text text-decoration-none">Esqueceu sua senha?</a>
                    </div>
                    <button type="button" id="loginButton" class="btn btn-primary w-100 btn-lg">Entrar</button>
                </form>
                <hr>
                <div class="text-center">
                    <p class="text-muted">Não tem uma conta? <a href="#" class="text-decoration-none fw-bold">Cadastre-se</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="welcomeModal" tabindex="-1" aria-labelledby="welcomeModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 text-center d-block">
                <h4 class="modal-title w-100 fw-bold" id="welcomeModalLabel">Uma Oferta Especial para Você!</h4>
                <p class="text-muted mb-0">Bem-vindo(a) à TechON Tour Virtual!</p>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-gift-fill fs-1 text-primary" aria-hidden="true"></i>
                    <h5 class="fw-bold mt-2">Desbloqueie Vantagens Exclusivas!</h5>
                    <p class="text-muted">Crie sua conta ou faça login para aproveitar benefícios que só nossos clientes têm:</p>
                </div>
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-3 mt-1" aria-hidden="true"></i>
                        <div>
                            <strong class="d-block">10% de Desconto Garantido</strong>
                            <span class="text-muted">Receba um cupom de 10% de desconto para usar no seu primeiro projeto conosco.</span>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-3 mt-1" aria-hidden="true"></i>
                        <div>
                            <strong class="d-block">Promoções e Novidades por E-mail</strong>
                            <span class="text-muted">Fique por dentro das nossas melhores ofertas e novas tecnologias antes de todo mundo.</span>
                        </div>
                    </li>
                    <li class="mb-3 d-flex align-items-start">
                        <i class="bi bi-check-circle-fill text-success me-3 mt-1" aria-hidden="true"></i>
                        <div>
                            <strong class="d-block">Histórico de Projetos</strong>
                            <span class="text-muted">Acesse facilmente todos os seus orçamentos e projetos concluídos em um só lugar.</span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="modal-footer flex-column border-0">
                <a href="#" class="btn btn-primary btn-lg w-100 mb-2">Criar Minha Conta Grátis</a>
                <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" data-bs-dismiss="modal" class="btn btn-outline-secondary w-100">Já tenho uma conta (Fazer Login)</a>
                <button type="button" class="btn btn-link text-muted mt-2" data-bs-dismiss="modal">Agora não, obrigado</button>
            </div>
        </div>
    </div>
</div>
    
<%- include('partials/footer') %>