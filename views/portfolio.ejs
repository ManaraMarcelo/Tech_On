<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main role="main">
    <section class="bg-light py-5 text-center">
      <div class="container">
        <h1 class="display-4 fw-bold">Nosso Portfólio</h1>
        <p class="lead text-muted">Uma galeria dos nossos melhores trabalhos em tours virtuais e fotografia imersiva.</p>
      </div>
    </section>
  
    <section class="py-5">
      <div class="container">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  
          <div class="col">
            <div class="card h-100 shadow-sm border-0 overflow-hidden">
              <div class="ratio ratio-16x9">
                <iframe
                  src="https://my.matterport.com/show/?m=31n8LB2vvxn"
                  frameborder="0"
                  allowfullscreen
                  allow="autoplay; fullscreen; web-share; xr-spatial-tracking;"
                  loading="lazy"
                  title="Tour 360° - Estúdio Boxe Mario Paiva">
                </iframe>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold">Estúdio Boxe Mario Paiva</h5>
                <p class="card-text text-muted small">
                  Tour virtual 360° do estúdio de boxe, destacando estrutura e ambiente de treino.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="badge bg-danger-subtle text-danger">Esportivo</span>
                  <a href="https://my.matterport.com/show/?m=31n8LB2vvxn" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Abrir em Tela Cheia</a>
                </div>
              </div>
            </div>
          </div>
  
          <div class="col">
            <div class="card h-100 shadow-sm border-0 overflow-hidden">
              <div class="ratio ratio-16x9">
                <iframe
                  src="https://my.matterport.com/show/?m=rCybmEbgj4Q"
                  frameborder="0"
                  allowfullscreen
                  allow="autoplay; fullscreen; web-share; xr-spatial-tracking;"
                  loading="lazy"
                  title="Tour 360° - Paiva Utilidades">
                </iframe>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold">Paiva Utilidades</h5>
                <p class="card-text text-muted small">
                  Tour virtual 360° mostrando os ambientes da loja e suas utilidades domésticas.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="badge bg-success-subtle text-success">Comercial</span>
                  <a href="https://my.matterport.com/show/?m=rCybmEbgj4Q" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Abrir em Tela Cheia</a>
                </div>
              </div>
            </div>
          </div>
  
          <div class="col">
            <div class="card h-100 shadow-sm border-0 overflow-hidden">
              <div class="ratio ratio-16x9">
                <iframe
                  src="https://my.matterport.com/show/?m=vYCjNuY8BSb"
                  frameborder="0"
                  allowfullscreen
                  allow="autoplay; fullscreen; web-share; xr-spatial-tracking;"
                  loading="lazy"
                  title="Tour 360° - Fatec Arthur de Azevedo">
                </iframe>
              </div>
              <div class="card-body">
                <h5 class="card-title fw-bold">Fatec - Arthur de Azevedo</h5>
                <p class="card-text text-muted small">
                  Tour virtual 360° da Fatec Mogi Mirim, explorando salas de aula, oficinas e áreas comuns.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="badge bg-primary-subtle text-primary">Educacional</span>
                  <a href="https://my.matterport.com/show/?m=vYCjNuY8BSb" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Abrir em Tela Cheia</a>
                </div>
              </div>
            </div>
          </div>
  
        </div>
      </div>
    </section>
  
    <section class="py-5 text-center text-white" style="background: linear-gradient(135deg, #4285f4, #3367d6);">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-3">Seu Projeto Merece Destaque</h2>
            <p class="lead mb-4">
              Queremos ajudar você a apresentar seu espaço de forma impactante. Fale conosco para criar o seu próprio tour virtual.
            </p>
            <a href="/contato" class="btn btn-light btn-lg">Solicitar Orçamento</a>
          </div>
        </div>
      </div>
    </section>
</main>
  
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="loginModalLabel">Acessar sua Conta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="loginError" class="alert alert-danger d-none" role="alert">
                    E-mail ou senha incorretos. Tente novamente.
                </div>
                <form>
                    <div class="mb-3">
                        <label for="emailInput" class="form-label">Endereço de e-mail</label>
                        <input type="email" class="form-control" id="emailInput" placeholder="seuemail@exemplo.com" required>
                    </div>
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label">Senha</label>
                        <input type="password" class="form-control" id="passwordInput" placeholder="Sua senha" required>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="rememberCheck">
                            <label class="form-check-label" for="rememberCheck">Lembrar de mim</label>
                        </div>
                        <a href="#" class="form-text text-decoration-none">Esqueceu sua senha?</a>
                    </div>
                    <button type="button" id="loginButton" class="btn btn-primary w-100 btn-lg">Entrar</button>
                </form>
                <hr>
                <div class="text-center">
                    <p class="text-muted">Não tem uma conta? <a href="#" class="text-decoration-none fw-bold">Cadastre-se</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
  
<%- include('partials/footer') %>